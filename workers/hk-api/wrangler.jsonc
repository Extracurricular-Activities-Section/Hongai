{
  "name": "hongai",
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Local only — never put Superuser credentials here.
  // Secrets: HK_PB_SERVICE_EMAIL, HK_PB_SERVICE_PASSWORD, HK_SCHEDULER_SECRET, …
  "vars": {
    "HK_POCKETBASE_URL": "https://db.keson.pro",
    "HK_STUDENT_APP_URL": "https://hong-ai-dream-frontend.pages.dev",
    "HK_MANAGE_APP_URL": "https://hong-ai-dream-frontend.pages.dev",
    "HK_EXTRA_ORIGINS": "http://localhost:5173"
    // Secrets (not in vars): HK_PB_SERVICE_*, HK_SCHEDULER_SECRET,
    // HK_PDF_SERVICE_URL, HK_PDF_SERVICE_SECRET, HK_VERIFY_BASE_URL
  },
  // Enable after secrets + PB host ready. Local `wrangler dev` accepts triggers without prod deploy.
  "triggers": {
    "crons": ["0 1 * * *"]
  }
  // Queues: add bindings when Cloudflare Queues is provisioned — see docs/CLOUDFLARE-ARCHITECTURE.md
}
