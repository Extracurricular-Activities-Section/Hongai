{
  "name": "hong-ai-dream-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint .",
    "migrate:check": "node ./scripts/check-migrations.mjs",
    "pdf:smoke": "node ./pdf-engine/smoke.mjs",
    "pdf:service": "node ./pdf-engine/service.mjs",
    "pdf:container:install": "npm --prefix ./workers/hk-pdf install && npm --prefix ./pdf-engine install",
    "pdf:container:typecheck": "npm --prefix ./workers/hk-pdf run typecheck",
    "pdf:container:deploy": "npm --prefix ./workers/hk-pdf run deploy",
    "attachment:smoke": "node ./scripts/attachment-security-smoke.mjs",
    "notification:smoke": "node ./scripts/notification-render-smoke.mjs",
    "security:secrets": "node ./scripts/security-secrets-scan.mjs",
    "preflight": "node ./scripts/production-preflight.mjs",
    "preview": "vite preview",
    "worker:dev": "npm --prefix ./workers/hk-api run dev",
    "worker:typecheck": "npm --prefix ./workers/hk-api run typecheck",
    "worker:install": "npm --prefix ./workers/hk-api install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "pdf-lib": "^1.17.1",
    "pocketbase": "^0.28.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  }
}
