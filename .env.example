VITE_POCKETBASE_URL=https://db.keson.pro
# Required for all /api/hk/* business APIs. Do not point this at PocketBase.
# Local: VITE_HK_API_BASE_URL=http://127.0.0.1:8787
VITE_HK_API_BASE_URL=http://127.0.0.1:8787
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
# Optional public maintenance banner (frontend only — does not replace backend security)
# VITE_MAINTENANCE_MODE=false
# VITE_APP_BASE_URL=https://your-frontend.example

# PDF render service (Cloudflare/PDF orchestration calls this; local: npm run pdf:service)
HK_PDF_SERVICE_URL=http://127.0.0.1:8788
HK_PDF_SERVICE_SECRET=hk-dev-pdf-secret
HK_VERIFY_BASE_URL=http://localhost:5173
# Optional Chinese font path (Noto Sans TC 等，需確認授權；勿依賴本機 Windows Fonts 上線)
# PDF_FONT_PATH=/var/fonts/NotoSansCJKtc-Regular.otf

# Attachment upload limit (MB) — Worker upload routes read this
HK_MAX_UPLOAD_SIZE_MB=10

# App base URL (used in notification action links / email context)
HK_APP_BASE_URL=http://localhost:5173

# Mail provider:
#   disabled  = 站內通知正常，Email 標記 skipped_provider_disabled（不上線假寄信）
#   development / console = 模擬寄送
#   none / 空 = NOT CONFIGURED
#   smtp = JSVM 未完整實作，需外部 worker
HK_MAIL_PROVIDER=development
HK_MAIL_FROM_EMAIL=noreply@example.com
HK_MAIL_FROM_NAME=弘愛築夢系統
# SMTP_* only if bridging to an external worker later — never commit real passwords
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Support contacts shown in mail config / status (optional)
HK_SUPPORT_EMAIL=
HK_SUPPORT_PHONE=

# Internal scheduler endpoints (/api/hk/internal/notifications/*)
# Header: X-HK-Scheduler-Secret  （禁止 query string）
HK_SCHEDULER_SECRET=hk-dev-scheduler-secret

# --- Cloudflare API layer (Workers) — browser calls these, not PocketBase directly ---
# HK_API_BASE_URL=http://127.0.0.1:8787
# HK_STUDENT_APP_URL=http://localhost:5173
# HK_MANAGE_APP_URL=http://localhost:5173
# Server-only (wrangler secrets / .dev.vars — never VITE_):
# HK_POCKETBASE_URL=https://db.keson.pro
# HK_PB_SERVICE_EMAIL=        # hk_staff_users account with role=service
# HK_PB_SERVICE_PASSWORD=
