VITE_POCKETBASE_URL=https://db.keson.pro
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
# Optional public maintenance banner (frontend only — does not replace backend security)
# VITE_MAINTENANCE_MODE=false
# VITE_APP_BASE_URL=https://your-frontend.example

# PDF render service (PocketBase hooks call this; local: npm run pdf:service)
HAD_PDF_SERVICE_URL=http://127.0.0.1:8788
HAD_PDF_SERVICE_SECRET=had-dev-pdf-secret
HAD_VERIFY_BASE_URL=http://localhost:5173
# Optional Chinese font path (Noto Sans TC 等，需確認授權；勿依賴本機 Windows Fonts 上線)
# PDF_FONT_PATH=/var/fonts/NotoSansCJKtc-Regular.otf

# Attachment upload limit (MB) — PocketBase hooks read this
HAD_MAX_UPLOAD_SIZE_MB=10

# App base URL (used in notification action links / email context)
HAD_APP_BASE_URL=http://localhost:5173

# Mail provider:
#   disabled  = 站內通知正常，Email 標記 skipped_provider_disabled（不上線假寄信）
#   development / console = 模擬寄送
#   none / 空 = NOT CONFIGURED
#   smtp = JSVM 未完整實作，需外部 worker
HAD_MAIL_PROVIDER=development
HAD_MAIL_FROM_EMAIL=noreply@example.com
HAD_MAIL_FROM_NAME=弘愛築夢系統
# SMTP_* only if bridging to an external worker later — never commit real passwords
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Support contacts shown in mail config / status (optional)
HAD_SUPPORT_EMAIL=
HAD_SUPPORT_PHONE=

# Internal scheduler endpoints (/api/had/internal/notifications/*)
# Header: X-HAD-Scheduler-Secret  （禁止 query string）
HAD_SCHEDULER_SECRET=had-dev-scheduler-secret
